# Copy to .env.local. Everything is optional for local development.

# Gemini agents: either an API key (local) ...
GEMINI_API_KEY=
# ... or Vertex AI (production on Google Cloud, uses the service account)
# GEMINI_PROVIDER=vertex
# GOOGLE_CLOUD_PROJECT=your-project-id
# VERTEX_LOCATION=global
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# "Try the live demo" button on the sign-in page
DEMO_MODE=1

# Postgres. Unset = embedded PGlite under .data/
# DATABASE_URL=postgresql://...
# Used only by scripts/deploy-cloudrun.sh
# CLOUD_DATABASE_URL=postgresql://...

# Required in production
# APP_SECRET=          # 32+ random characters: openssl rand -base64 48
# APP_URL=https://your-domain
# CRON_SECRET=

# Email (sign-in links, invites). Without one, links print to the server log.
# RESEND_API_KEY=
# RESEND_FROM=

# Mirror live agent runs to Cloud Firestore (Native mode); the live views read them from there.
# FIRESTORE_RUNS=1
